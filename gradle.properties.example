# Gradle Properties Template
# Copy this file to gradle.properties and add your API keys
# DO NOT commit gradle.properties to version control

org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8
android.useAndroidX=true
android.enableJetifier=true

# API Keys - Add your keys here
# Get Groq API key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODEL=llama-3.1-8b-instant

# Alternative models:
# - llama-3.1-8b-instant (fast, free tier)
# - llama-3.1-70b-versatile (better quality, may have rate limits)

